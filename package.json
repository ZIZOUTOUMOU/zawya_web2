{
  "name": "zawiya-digital-center",
  "version": "1.0.0",
  "description": "الزاوية — المركز الثقافي والتعليمي",
  "main": "backend/server.js",
  "scripts": {
    "start":    "node backend/server.js",
"render-build": "npm install && npm install --prefix frontend-react && npm run --prefix frontend-react build",
    "dev":      "nodemon backend/server.js",
    "init-db":  "node backend/database/init.js",
    "seed":     "node backend/database/seed.js",
    "seed:catalog": "node backend/database/seed_extracted.js"
  },
  "dependencies": {
    "bcryptjs":           "^2.4.3",
    "cookie-parser":      "^1.4.7",
    "cors":               "^2.8.5",
    "dotenv":             "^16.4.5",
    "express":            "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-validator":  "^7.2.0",
    "helmet":             "^8.0.0",
    "jimp":               "^1.6.1",
    "jsonwebtoken":       "^9.0.2",
    "multer":             "^1.4.5-lts.1",
    "node-fetch":         "^2.7.0",
    "sanitize-html":      "^2.13.0",
    "sql.js":             "^1.10.3",
    "uuid":               "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
